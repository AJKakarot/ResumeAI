# Copy to .env.local and replace every placeholder with values from your dashboards.
# Never commit .env.local or real keys.

# ─── App URL (optional; recommended in production for redirects & webhooks) ───
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# Clerk — https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
# Pro / premium: set automatically when Razorpay payment succeeds (verify + webhook),
# or manually: Dashboard → Users → Public metadata: { "premium": true } or { "plan": "pro" }
# (Required for Gemini polish on home analyze and POST /api/roast-resume.)

# Supabase — Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Supabase — Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Server-only — Settings → API → service_role (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Google AI Studio — https://aistudio.google.com/apikey (server-only)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional — app default is gemini-2.5-flash when unset. Override if needed:
# GEMINI_MODEL=gemini-2.5-flash
# Optional — Pro-only full ATS report (POST /api/resume-deep-report); defaults to GEMINI_MODEL
# GEMINI_DEEP_REPORT_MODEL=gemini-2.5-flash
# Optional — override model only for “roast my resume” (defaults to GEMINI_MODEL)
# GEMINI_ROAST_MODEL=gemini-2.5-flash

# Gemini rate limits (in-process; use Redis/Upstash in multi-instance production)
# GEMINI_RL_RPM=18
# Estimated output tokens budgeted per call (input is measured from prompt length)
# GEMINI_RL_OUTPUT_TOKEN_ESTIMATE=2800
# Daily estimated token budget (UTC) — free / anonymous vs Pro
# GEMINI_RL_DAILY_TOKEN_BUDGET_FREE=120000
# GEMINI_RL_DAILY_TOKEN_BUDGET_PRO=900000
# Optional global requests/minute across all users (0 = disabled)
# GEMINI_RL_GLOBAL_RPM=180

# ═══════════════════════════════════════════════════════════════════════════
# Razorpay (one-time order + Checkout) — https://dashboard.razorpay.com/app/keys
# ═══════════════════════════════════════════════════════════════════════════
# Key ID is safe to expose; Key Secret is server-only.
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# (Aliases also work: razorpay_key_id / razorpay_key_secret — same values.)
#
# Amount in paise (e.g. 99900 = ₹999.00). Minimum 100.
# RAZORPAY_PRO_AMOUNT_PAISE=99900
# RAZORPAY_CURRENCY=INR
#
# Webhook — Dashboard → Webhooks → URL: https://YOUR_DOMAIN/api/webhooks/razorpay
# Use the webhook secret shown when you create the webhook (not the API secret).
# RAZORPAY_WEBHOOK_SECRET=...
#
# Optional: open a Razorpay Payment Button / hosted link instead of API order flow:
# NEXT_PUBLIC_RAZORPAY_PRO_URL=https://razorpay.com/payment-button/plink_...
